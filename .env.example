# Si quieres correr la app de manera local
#EXPO_PUBLIC_API_URL=http://TU_IP_LOCAL:8080/api
# O sea, la IP local de la laptop o PC. Ya que 
# se correrá en Expo Go en Android.
# Pero si utilizarás un emulador de Android en la PC puedes poner 10.0.2.2
# Igual en ambos casos sirve tu IP local.


# Si quieres correr la app con el backend desplegado
#EXPO_PUBLIC_API_URL=LINK_DEL_BACKEND
